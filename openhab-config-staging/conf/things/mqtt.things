// MQTT broker bridge.
// The UI-managed LoRa water-level Thing mqtt:topic:mosquitto:lora_sb_001 uses this bridge.
// The temperature/humidity sensors (living room, child room) report through the Shelly
// binding; their former MQTT topic Things had no linked items and no broker traffic.

Bridge mqtt:broker:mosquitto "MQTT Broker" @ "Kuhstall" [
    host="mqtt",
    port=1883,
    clientId="openhab",
    keepAlive=60,
    reconnect=true
]
