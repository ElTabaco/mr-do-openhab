// Timer for the start watchdog
var Timer wallboxStartTimer = null

// Wallbox (Juice Charger me, OCPP binding) - derived values.
// The wallbox has no energy meter, so power is an ESTIMATE:
//   offered current (OCPP MeterValues Current.Offered) x 230 V x 3 phases, only while Status == Charging.
//   If the box does not report Current.Offered, the active charge limit is used (16 A when no limit is set).
// The car may draw less than offered (battery full, charge schedule in the car).

val double VOLTAGE = 230.0
val double PHASES = 3.0
val double BOX_MAX_A = 16.0

rule "Wallbox power estimate"
when
    System started or
    Item Wallbox_Status changed or
    Item Wallbox_ChargeLimit changed
then
    var double amps = 0.0
    if (Wallbox_Status.state.toString == "Charging") {
        if (Wallbox_ChargeLimit.state instanceof QuantityType) {
            amps = Math::min((Wallbox_ChargeLimit.state as QuantityType<?>).toUnit("A").doubleValue, BOX_MAX_A)
        } else {
            amps = BOX_MAX_A
        }
    }
    Wallbox_PowerEstimate.postUpdate((amps * VOLTAGE * PHASES / 1000.0).toString + " kW")
end

rule "Wallbox session duration"
when
    Time cron "0 * * ? * *" or
    Item Wallbox_TransactionId changed
then
    if (Wallbox_TransactionId.state instanceof DecimalType && Wallbox_SessionStart.state instanceof DateTimeType) {
        val start = (Wallbox_SessionStart.state as DateTimeType).getZonedDateTime(java.time.ZoneId.systemDefault())
        val minutes = java.time.Duration.between(start, java.time.ZonedDateTime.now()).toMinutes
        Wallbox_SessionDuration.postUpdate(minutes.toString + " min")
    }
end

// Session number = OCPP transaction id; kept after the session ends (transaction-id becomes UNDEF then).
rule "Wallbox session number"
when
    System started or
    Item Wallbox_TransactionId changed
then
    if (Wallbox_TransactionId.state instanceof DecimalType) {
        Wallbox_SessionNumber.postUpdate(Wallbox_TransactionId.state)
    }
end

// Stop/Start on the page = pause/resume. A pause must not carry over into the next plug-in:
// when the session ends, lift the pause (the charge limit stays).
rule "Wallbox clear pause at session end"
when
    Item Wallbox_TransactionId changed
then
    if (!(Wallbox_TransactionId.state instanceof DecimalType) && Wallbox_Pause.state == ON) {
        Wallbox_Pause.sendCommand(OFF)
    }
end

// Start watchdog: with free charging the charger starts a session within a second of the plug-in.
// If there is none after 60 s: send one remote start; if still none after 30 s more: show a warning
// (the charger is then blocked until a reboot via its web UI).
rule "Wallbox start watchdog"
when
    Item Wallbox_Status changed to Preparing
then
    wallboxStartTimer?.cancel
    wallboxStartTimer = createTimer(now.plusSeconds(60), [|
        if (Wallbox_Status.state.toString == "Preparing" && !(Wallbox_TransactionId.state instanceof DecimalType)) {
            logWarn("wallbox", "No session 60 s after plug-in - sending remote start")
            Wallbox_Charging.sendCommand(ON)
            wallboxStartTimer = createTimer(now.plusSeconds(30), [|
                if (Wallbox_Status.state.toString == "Preparing" && !(Wallbox_TransactionId.state instanceof DecimalType)) {
                    logWarn("wallbox", "Charger did not start a session - reboot it via its web UI")
                    Wallbox_StartBlocked.postUpdate(ON)
                }
                wallboxStartTimer = null
            ])
        } else {
            wallboxStartTimer = null
        }
    ])
end

rule "Wallbox start watchdog reset"
when
    System started or
    Item Wallbox_TransactionId changed or
    Item Wallbox_Cable changed to OFF
then
    if (Wallbox_TransactionId.state instanceof DecimalType || Wallbox_Cable.state == OFF) {
        Wallbox_StartBlocked.postUpdate(OFF)
    }
end
