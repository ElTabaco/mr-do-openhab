var Timer countdownViehhueterNordTimer = null

rule "ViehhueterNord_Power_ON_Timer"
when
    Item Viehhueter_Power changed
then
    if (Viehhueter_Power.state == ON)
    {
            if (countdownViehhueterNordTimer != NULL)
            {
                countdownViehhueterNordTimer?.cancel
                countdownViehhueterNordTimer = null
                Viehhueter_Countdown.postUpdate(0)
            }
    }
    else if (Viehhueter_Mode.state==OFF)
    {
            var remain = 120 //min
            if (Viehhueter_Countdown_Time.state != NULL)
            {
                remain = ((((Viehhueter_Countdown_Time.state as QuantityType<Number>).toBigDecimal).intValue) * 60)
            }
            Viehhueter_Countdown.postUpdate(remain)
            countdownViehhueterNordTimer = createTimer(now.plusMinutes(1), [|
            remain = remain - 1
            if( remain <= 0 ) {
                remain = 0
                Viehhueter_Power.sendCommand(ON)
            }
            Viehhueter_Countdown.postUpdate(remain)
            if( remain > 0){ countdownViehhueterNordTimer.reschedule(now.plusMinutes(1))
            }    ])
    }
end
