rule "KuhstahlSensorenPharser"
when
    Item KuhstahlSensoren received update
then
    val String json = KuhstahlSensoren.state.toString
    val long nowSec = now.toEpochSecond
    // [item, MobileAlerts device index, measurement field]
    // devices[0]: outside sensor, the only device requested by mobileAlerts_REST_API.sh
    // (the drying plant sensors before/after and roof were removed: no data since 2022/2023)
    val targets = newArrayList(
        newArrayList("trocknungsanlage_Outside_Temp", "0", "t1"),
        newArrayList("trocknungsanlage_Outside_Humidity", "0", "h"))
    targets.forEach[ t |
        // A value is only valid when it is a real reading:
        // - 43530 (and higher) is the MobileAlerts error code for "no reading / probe not connected";
        // - the cloud API keeps returning the last measurement of a sensor that stopped
        //   transmitting, so a measurement older than 3600 s (field "ts") counts as no reading.
        // Invalid values set the item to UNDEF instead of showing a wrong number.
        val String prefix = "$.devices[" + t.get(1) + "].measurement."
        var String value = "UNDEF"
        try {
            val String ts = transform("JSONPATH", prefix + "ts", json)
            val String raw = transform("JSONPATH", prefix + t.get(2), json)
            if (ts !== null && raw !== null
                    && nowSec - new java.math.BigDecimal(ts).longValue <= 3600
                    && Double::parseDouble(raw) < 43530) {
                value = raw
            }
        } catch (Exception e) {
            logWarn("kuhStahlSensoren", "Cannot read {} from MobileAlerts response: {}", t.get(0), e.getMessage)
        }
        postUpdate(t.get(0), value)
    ]
end