var Timer countdownViehhueterSuedTimer = null

rule "ViehhueterSued_Power_ON_Timer"
when
    Item ViehhueterSued_Power changed
then
    if (ViehhueterSued_Power.state == ON)
    {
            if (countdownViehhueterSuedTimer != NULL)
            {
                countdownViehhueterSuedTimer?.cancel
                countdownViehhueterSuedTimer = null
                ViehhueterSued_Countdown.postUpdate(0)
            }
    }
    else if (ViehhueterSued_Mode.state==OFF)
    {
            var remain = 120 //min
            if (ViehhueterSued_Countdown_Time.state != NULL)
            {
                remain = ((((ViehhueterSued_Countdown_Time.state as QuantityType<Number>).toBigDecimal).intValue) * 60)
            }
            ViehhueterSued_Countdown.postUpdate(remain)
            countdownViehhueterSuedTimer = createTimer(now.plusMinutes(1), [|
            remain = remain - 1
            if( remain <= 0 ) {
                remain = 0
                ViehhueterSued_Power.sendCommand(ON)
            }
            ViehhueterSued_Countdown.postUpdate(remain)
            if( remain > 0){ countdownViehhueterSuedTimer.reschedule(now.plusMinutes(1))
            }    ])
    }
end
