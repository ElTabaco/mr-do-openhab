import java.net.URLEncoder
rule "Stoeckli Smoke Rule"
when
    Item stoeckliSmoke_Smoke_Alarm changed to ON
then
        sendNotification("<NOTIFICATION_EMAIL>", "ACHTUNG Stöckli brennt! ACHTUNG Stöckli brennt! ACHTUNG Stöckli brennt! ACHTUNG Stöckli brennt!", "Smoke", "high")
        val urlmessage = URLEncoder::encode("ACHTUNG Stöckli brennt", 'UTF-8')
        sendHttpGetRequest("http://api.callmebot.com/start.php?source=openHAB&user=@<CALLMEBOT_TELEGRAM_USER>&lang=de-DE-Standard-A&text=" + urlmessage)
end
